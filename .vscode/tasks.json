{
    "version": "2.0.0",
    "tasks": [
      {
        "type": "dotnet",
        "task": "build",
        "group": {
            "kind": "build",
            "isDefault": true
        },
        "problemMatcher": [],
        "label": "build"
      },
      {
      "type": "process",
      "label": "build-release",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/AgentModelV2.csproj",
        "-c",
        "Release"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
    ]
  }